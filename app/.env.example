# ── SCEGLI IL PROVIDER ────────────────────────────────────────────────────────
# gemini   → GRATIS, supporta immagini e PDF  ← CONSIGLIATO
# groq     → GRATIS, solo testo, molto veloce
# anthropic → A PAGAMENTO (~$1-3/mese uso personale)
PROVIDER=gemini

# ── API KEY (solo quella del provider scelto) ──────────────────────────────────

# GEMINI (gratis): console su https://aistudio.google.com → "Get API Key"
GOOGLE_API_KEY=

# GROQ (gratis): console su https://console.groq.com → "API Keys"
GROQ_API_KEY=

# ANTHROPIC (pagamento): console su https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── MODELLO (opzionale, ha già default intelligenti) ──────────────────────────
# gemini:    gemini-2.0-flash  (default) | gemini-1.5-pro
# groq:      llama-3.3-70b-versatile (default) | mixtral-8x7b-32768
# anthropic: claude-sonnet-4-6 (default) | claude-opus-4-8
# MODEL=
